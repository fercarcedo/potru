---
import Layout from '../../../layouts/Layout.astro';
import NodeDetail from '../../../components/NodeDetail.astro';
import Viewer3D from '../../../components/Viewer3D.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { ALL_NODES, ontCount, type NetworkNode } from '../../../lib/data';

/* Same locale-crossing shape as [...locale]/index.astro: one entry per
   node per locale, es unprefixed and en under /en/. */
export function getStaticPaths() {
  return (['es', 'en'] as const).flatMap((locale) =>
    ALL_NODES.map((node) => ({
      params: { locale: locale === 'es' ? undefined : locale, id: node.id },
      props: { node },
    })),
  );
}

interface Props {
  node: NetworkNode;
}

const { node } = Astro.props;
const desc =
  node.id === 'pao'
    ? `${node.name}: punto de acceso de operadores de la Red Asturcón. ${node.enclosure}`
    : `Nodo ${node.name} (área ${node.area}): ${node.olts.length} OLT y ${ontCount(node)} ONT en servicio, migración prevista en las semanas ${node.weekFrom}–${node.weekTo} de la Fase 2 del pliego CON 06/2025.`;
---

<Layout title={`${node.name} · Potru · renovación GPON → XGS-PON`} description={desc}>
  <section class="node-page">
    <div class="wrap">
      <NodeDetail node={node} />
    </div>
  </section>
  <Viewer3D />
  <Lightbox />
</Layout>

<script>
  import { initWalk, openWalk } from '../../../scripts/walk';
  import { initLightbox } from '../../../scripts/lightbox';

  initWalk();
  initLightbox();
  const btn = document.querySelector<HTMLButtonElement>('[data-walk]');
  btn?.addEventListener('click', () => openWalk(btn.dataset.walk!));
</script>
