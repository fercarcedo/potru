---
import Layout from '../../../layouts/Layout.astro';
import NodeDetail from '../../../components/NodeDetail.astro';
import Viewer3D from '../../../components/Viewer3D.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { ALL_NODES, nodeById, ontCount, type NetworkNode } from '../../../lib/data';
import { ui } from '../../../i18n/ui';

/* Same locale-crossing shape as [...locale]/index.astro: one entry per
   node per locale, es unprefixed and en under /en/. Each route gets that
   locale's own resolution of the node's free text (enclosure, extra, …),
   not just the Spanish default. */
export function getStaticPaths() {
  return (['es', 'en'] as const).flatMap((locale) =>
    ALL_NODES.map((node) => ({
      params: { locale: locale === 'es' ? undefined : locale, id: node.id },
      props: { node: nodeById(node.id, locale)! },
    })),
  );
}

interface Props {
  node: NetworkNode;
}

const { node } = Astro.props;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale);
const desc =
  node.id === 'pao'
    ? t.meta.paoDescription(node.name, node.enclosure)
    : t.meta.nodeDescription({
        name: node.name,
        area: node.area,
        olts: node.olts.length,
        onts: ontCount(node),
        weekFrom: node.weekFrom,
        weekTo: node.weekTo,
      });
---

<Layout title={t.meta.nodeTitle(node.name)} description={desc}>
  <section class="node-page">
    <div class="wrap">
      <NodeDetail node={node} />
    </div>
  </section>
  <Viewer3D />
  <Lightbox />
</Layout>

<script>
  import { initWalk, openWalk } from '../../../scripts/walk';
  import { initLightbox } from '../../../scripts/lightbox';

  initWalk();
  initLightbox();
  const btn = document.querySelector<HTMLButtonElement>('[data-walk]');
  btn?.addEventListener('click', () => openWalk(btn.dataset.walk!));
</script>
