---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Diagram from '../../components/Diagram.astro';
import NetworkMap from '../../components/NetworkMap.astro';
import NodeGrid from '../../components/NodeGrid.astro';
import Architecture from '../../components/Architecture.astro';
import Actions from '../../components/Actions.astro';
import Phases from '../../components/Phases.astro';
import NodeModal from '../../components/NodeModal.astro';
import Viewer3D from '../../components/Viewer3D.astro';
import Lightbox from '../../components/Lightbox.astro';
import FullscreenViewer from '../../components/FullscreenViewer.astro';
import { ui } from '../../i18n/ui';

/* Two renderings of the same page: Spanish unprefixed at /, English at /en/.
   The [...locale] rest param matches zero segments when `locale` is
   undefined, which is what gives the default locale its bare URL — see
   astro.config.mjs's `prefixDefaultLocale: false`. */
export function getStaticPaths() {
  return (['es', 'en'] as const).map((locale) => ({
    params: { locale: locale === 'es' ? undefined : locale },
  }));
}

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
---

<Layout title={ui(locale).meta.homeTitle}>
  <Hero />
  <Diagram />
  <NetworkMap />
  <NodeGrid />
  <Architecture />
  <Actions />
  <Phases />
  <NodeModal />
  <Viewer3D />
  <Lightbox />
  <FullscreenViewer />
</Layout>

<script>
  import '../../scripts/main';
</script>
