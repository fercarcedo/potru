---
import { DOM } from '../lib/dom-ids';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Visor divulgativo de la renovación GPON → XGS-PON de la Red Asturcón, la red pública FTTH de Asturias, según el pliego CON 06/2025 de GIT. Proyecto independiente.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const nav = [
  ['#viz', 'Red en vivo'],
  ['#mapa', 'Mapa'],
  ['#nodos', 'Nodos'],
  ['#arquitectura', 'Arquitectura'],
  ['#actuaciones', 'Actuaciones'],
  ['#fases', 'Fases'],
];
/** On node pages the anchors have to point back at the home page. */
const anchorPrefix = Astro.url.pathname === base ? '' : base;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      /*
      Stamps the visitor's stored theme before the first paint. This cannot be
      a module script: those are deferred, so the page would paint in the
      system theme and then snap to the chosen one — the flash every themed
      site gets wrong once. Kept deliberately tiny, and it must agree with
      `KEY` in src/scripts/theme.ts.
    */
    }
    <script is:inline>
      try {
        var t = localStorage.getItem('potru:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {
        /* storage unavailable: fall through to prefers-color-scheme */
      }
    </script>
  </head>
  <body>
    <nav>
      <div class="wrap">
        <div class="brand">
          <b>Potru<span class="dot">.</span></b>
        </div>
        <div class="nav-right">
          <ul id={DOM.navMenu}>
            {
              nav.map(([href, label]) => (
                <li>
                  <a href={`${anchorPrefix}${href}`}>{label}</a>
                </li>
              ))
            }
          </ul>
          {
            /* Two icons, always both in the markup, one shown at a time by CSS
              keyed off data-theme — see the .theme-toggle rules below. Each
              names the *destination*: the sun shows in dark mode because
              pressing it takes you to light, and vice versa, matching the
              aria-label theme.ts writes. JS only reveals the button at all
              (see theme.ts) — without it, the icons sit inert and hidden. */
          }
          <button id={DOM.themeToggle} class="theme-toggle" type="button" hidden>
            <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true" fill="none">
              <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.6"></circle>
              <path
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                d="M10 1.6v2.2M10 16.2v2.2M18.4 10h-2.2M3.8 10H1.6M15.6 4.4l-1.6 1.6M6 14l-1.6 1.6M15.6 15.6L14 14M6 6 4.4 4.4"
              ></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true" fill="none">
              <path fill="currentColor" d="M17 12.4A7.2 7.2 0 0 1 7.6 3a7.6 7.6 0 1 0 9.4 9.4Z"
              ></path>
            </svg>
          </button>
          {
            /* Mobile-only hamburger, same hidden-until-JS pattern as the theme
              toggle above: without JS the link list already renders in full
              (see the no-JS nav ul rules below), so a button that cannot do
              anything must not appear. navmenu.ts reveals it and takes over
              collapsing #navMenu once it runs. */
          }
          <button
            id={DOM.navToggle}
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls={DOM.navMenu}
            hidden
          >
            <svg viewBox="0 0 20 20" aria-hidden="true" fill="none">
              <path
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                d="M3 5.5h14M3 10h14M3 14.5h14"></path>
            </svg>
            <span class="sr-only">Menú</span>
          </button>
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap">
        <span class="disclaimer"
          ><b>Proyecto independiente</b>, no afiliado a GIT ni al Principado de Asturias · fuente:
          pliego público CON 06/2025</span
        >
        <span
          >Fuente: Pliego de Condiciones Técnicas · EXPTE CON 06/2025 · aprobado 22-12-2025 · Datos,
          planos y calendario extraídos del propio pliego</span
        >
        <span class="mono"
          >GIT · Gestión de Infraestructuras Públicas de Telecomunicaciones del Principado de
          Asturias S.A.U., M.P.</span
        >
      </div>
    </footer>
  </body>
</html>

<script>
  import { initTheme } from '../scripts/theme';
  import { initNavMenu } from '../scripts/navmenu';

  initTheme();
  initNavMenu();
</script>

<style>
  /* Sticky nav and footer — both entirely this component's own markup, so
     scoping reaches every element below without a :global() escape.
     .disclaimer itself is global (see base.css): the footer's copy of it
     is a second, independent instance of that same class, not something
     this component's scope could reach anyway. */
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--veil);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  nav .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* The wordmark, and the only place the display face runs at full weight.
     The stop is the whole mark: a potru is a colt, the Asturcón's young
     counterpart, so the name already says «related, not the same thing» —
     it does not need a logotype to say it again. */
  .brand b {
    font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
    font-stretch: 78%;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--txt);
  }
  .brand .dot {
    color: var(--gpon);
  }
  nav ul {
    display: flex;
    gap: 20px;
    list-style: none;
  }
  nav a {
    font-family: 'IBM Plex Mono', monospace;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    padding: 4px 7px;
    border-radius: 3px;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  /* The pill highlight the redesign plan showed on hover — background in
     the institutional blue, same treatment the design gave the toggle and
     the section eyebrows, so the nav reads as part of the same system.
     .active is the same treatment, kept on for whichever section navspy.ts
     finds under the header as the visitor scrolls, not just under the
     pointer — plus its own font-weight, so it doesn't read as "just
     hovered" the moment the pointer lands on a different link. */
  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }
  nav a.active {
    font-weight: 600;
  }
  nav a:focus-visible {
    outline: 2px solid var(--xgs);
    outline-offset: 3px;
  }
  /* The legacy hid the nav below 820px, but its sliding nav only kicks in at
     760px, so navigation vanished in between. The rule is dropped and the
     max-width:760px sliding block below takes over. */

  /* Desktop default; the max-width:760px block below turns it on. Has to sit
     before that block — same specificity, so source order is what decides,
     and this unconditional rule would otherwise win over the media query's
     at every width. */
  .nav-toggle {
    display: none;
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 36px 0 48px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  footer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
  }
  footer .disclaimer {
    margin-top: 0;
    max-width: none;
  }

  @media (max-width: 760px) {
    /* Previously: an <ul> that overflow-x:auto'd horizontally, scrolling
       under its own steam because .wrap's align-items:flex-start left it
       shrink-to-fit instead of full-width — the fix relied on width:100%
       resolving against a container that, by definition, had no explicit
       width to resolve against. It silently did nothing: the list still
       ran off the screen, just now as real page overflow instead of a
       contained scrollbar (see navmenu.ts).
       Replaced with a collapsible menu, opened by the hamburger — but as
       part of the bar's own normal flow (a css grid, .nav-right's box
       suspended via display:contents so its children — the list and the
       two buttons — place directly into it) rather than an overlay
       floating on top: the list grows the sticky nav and pushes the page
       down, instead of covering whatever is directly under it.
       Without JS none of this collapsing happens — nav ul stays block-flex
       and simply prints every link in the header's own height, so
       navigation keeps working. */
    nav .wrap {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      column-gap: 10px;
      row-gap: 10px;
      height: auto;
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .brand {
      grid-column: 1;
      grid-row: 1;
    }
    .nav-right {
      display: contents;
    }
    .theme-toggle {
      grid-column: 2;
      grid-row: 1;
    }
    .nav-toggle {
      display: grid;
      place-items: center;
      grid-column: 3;
      grid-row: 1;
      width: 34px;
      height: 34px;
      color: var(--muted);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 9px;
      padding: 0;
      cursor: pointer;
    }
    .nav-toggle svg {
      width: 17px;
      height: 17px;
    }
    .nav-toggle[hidden] {
      display: none;
    }
    nav ul {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-direction: column;
      gap: 2px;
    }
    /* Author rules beat the UA stylesheet's own [hidden]{display:none} only
       because this one is more specific than nav ul{display:flex} above —
       without it navmenu.ts closing the menu would have no visible effect. */
    nav ul[hidden] {
      display: none;
    }
    nav li {
      flex: none;
      width: 100%;
    }
    nav li a {
      display: block;
      white-space: normal;
      padding: 11px 8px;
    }
    footer .wrap {
      flex-direction: column;
    }
  }
  /* Sits at the end of the nav, quiet until wanted. Hidden in the markup and
     revealed by theme.ts, so it never shows for a visitor whose JS did not
     run — pressing it would do nothing. */
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--muted);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0;
    cursor: pointer;
    flex: none;
  }
  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }
  /* the icon named for where the click goes: sun visible in dark (→ light),
     moon visible in light (→ dark) */
  .theme-toggle .i-moon {
    display: block;
  }
  .theme-toggle .i-sun {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .i-moon {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .i-sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .i-moon {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .i-sun {
      display: block;
    }
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
