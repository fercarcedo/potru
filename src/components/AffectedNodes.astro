---
import { NODES, byId } from '../lib/data';

interface Props {
  /** 'all' = the 20 primary nodes; otherwise a comma-separated list of ids */
  aff: string;
}

const { aff } = Astro.props;
const ids = aff === 'all' ? NODES.map((n) => n.id) : aff.split(',');
const base = import.meta.env.BASE_URL;
---

<div class="affected" data-aff={aff}>
  <span style="color:var(--dim)">Nodos afectados:</span>{' '}
  {
    ids.map((id, i) => (
      <>
        {i > 0 && ' · '}
        <a href={`${base}nodos/${id}`} data-node={id}>
          {byId[id]!.name}
        </a>
      </>
    ))
  }
</div>

<style>
  /* Was `.card .affected …` in ActionCard's stylesheet, back when everything
     lived in one global file. That descendant selector reached into this
     component's own markup only because both were global; now that
     ActionCard.astro is scoped, it can't reach a child component's elements
     at all, so the rule belongs here instead — this div and its <a> are
     this component's own template. */
  .affected {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .affected a {
    color: var(--xgs-tx);
    text-decoration: none;
    cursor: pointer;
  }
  .affected a:hover {
    text-decoration: underline;
  }
</style>
