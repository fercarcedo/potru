---
import { DOM } from '../lib/dom-ids';
import { ui } from '../i18n/ui';

// The end-to-end schematic is drawn by the src/scripts/diagram.ts island: its
// contents change with the GPON ↔ XGS-PON toggle and it carries animated pulses.
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).diagram;
const shared = ui(locale).shared;
---

<section id="viz">
  <div class="wrap">
    <div class="eyebrow">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="lead">
      {t.lead}
    </p>
    {
      /* Fullscreen (scripts/fullscreen.ts) moves this whole wrapper — the
        mode toggle and the info-box, not just .diagram-shell — so both the
        GPON ↔ XGS-PON switch and the click-an-element-for-its-info panel
        keep working: leaving either behind on the page would put it out of
        sight the moment fullscreen covers the page. */
    }
    <div id={DOM.diagramShell}>
      <div class="mode-toggle" role="tablist" aria-label={t.modeGroupLabel}>
        <button id={DOM.btnGpon} class="active-gpon" role="tab" aria-selected="true"
          >◉ {t.modeCurrent}</button
        >
        <button id={DOM.btnXgs} role="tab" aria-selected="false">◎ {t.modeRenewed}</button>
      </div>
      <div class="diagram-shell">
        <svg id={DOM.netDiagram} viewBox="0 0 1160 430" role="img" aria-label={t.diagramAria}></svg>
        <div class="zoom-pad" role="group" aria-label={t.zoomGroupLabel}>
          <button id={DOM.diagZoomIn} type="button" aria-label={t.zoomInLabel} title={t.zoomInTitle}
            >+</button
          >
          <button
            id={DOM.diagZoomOut}
            type="button"
            aria-label={t.zoomOutLabel}
            title={t.zoomOutTitle}>−</button
          >
        </div>
        {
          /* Kept off the svg entirely, unlike the zoom buttons above: at the
            diagram's own width:height ratio (~2.7:1) the usual absolute
            top-right overlay lands squarely on the PAO node's own labels on
            a phone (confirmed against the built output) — the same bug the
            wavelength ruler had (architecture.css), fixed the same way. Sits
            between the drawing and the caption legend below, rather than
            after it, so it reads as this drawing's own control rather than
            the legend's. */
        }
        <div class="zoom-pad fs-row" role="group" aria-label={t.fsGroupLabel}>
          <button
            type="button"
            class="fs-trigger"
            data-fs-target={DOM.diagramShell}
            aria-label={t.fsBtnLabel}
            title={shared.fullscreenTitle}>⛶</button
          >
        </div>
        <div class="diag-caption">
          <span><span class="dot" style="background:var(--gpon)"></span> {t.captionGpon}</span>
          <span><span class="dot" style="background:var(--xgs)"></span> {t.captionXgs}</span>
          <span><span class="dot" style="background:var(--dim)"></span> {t.captionPassive}</span>
          <span class="mono" style="margin-left:auto">▶ {t.captionPulses}</span>
        </div>
      </div>
      <div class="info-box" id={DOM.infoBox}>
        <b>{t.infoDefaultBold}</b>{t.infoDefaultRest}
      </div>
    </div>
  </div>
</section>
