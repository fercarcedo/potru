---
import { DOM } from '../lib/dom-ids';

// The end-to-end schematic is drawn by the src/scripts/diagram.ts island: its
// contents change with the GPON ↔ XGS-PON toggle and it carries animated pulses.
---

<section id="viz">
  <div class="wrap">
    <div class="eyebrow">Visualización inmersiva</div>
    <h2>Del salón del usuario al PAO de Gijón</h2>
    <p class="lead">
      Cadena completa de la red: ONT → red de acceso pasiva (splitters 1:16 y 1:4) → nodo primario
      con OLT → red troncal → punto de acceso de operadores. Cambia entre la red actual y la
      renovada, y pulsa cada elemento para conocer su papel.
    </p>
    {
      /* Fullscreen (scripts/fullscreen.ts) moves this whole wrapper — the
        mode toggle and the info-box, not just .diagram-shell — so both the
        GPON ↔ XGS-PON switch and the click-an-element-for-its-info panel
        keep working: leaving either behind on the page would put it out of
        sight the moment fullscreen covers the page. */
    }
    <div id={DOM.diagramShell}>
      <div class="mode-toggle" role="tablist" aria-label="Estado de la red">
        <button id={DOM.btnGpon} class="active-gpon" role="tab" aria-selected="true"
          >◉ RED ACTUAL · GPON</button
        >
        <button id={DOM.btnXgs} role="tab" aria-selected="false"
          >◎ RED RENOVADA · GPON/XGS-PON</button
        >
      </div>
      <div class="diagram-shell">
        <svg
          id={DOM.netDiagram}
          viewBox="0 0 1160 430"
          role="img"
          aria-label="Esquema de la Red Asturcón"></svg>
        <div class="zoom-pad" role="group" aria-label="Zoom del esquema">
          <button id={DOM.diagZoomIn} type="button" aria-label="Acercar el esquema" title="Acercar"
            >+</button
          >
          <button id={DOM.diagZoomOut} type="button" aria-label="Alejar el esquema" title="Alejar"
            >−</button
          >
        </div>
        {
          /* Kept off the svg entirely, unlike the zoom buttons above: at the
            diagram's own width:height ratio (~2.7:1) the usual absolute
            top-right overlay lands squarely on the PAO node's own labels on
            a phone (confirmed against the built output) — the same bug the
            wavelength ruler had (architecture.css), fixed the same way. Sits
            between the drawing and the caption legend below, rather than
            after it, so it reads as this drawing's own control rather than
            the legend's. */
        }
        <div class="zoom-pad fs-row" role="group" aria-label="Pantalla completa del esquema">
          <button
            type="button"
            class="fs-trigger"
            data-fs-target={DOM.diagramShell}
            aria-label="Ver el esquema a pantalla completa"
            title="Pantalla completa">⛶</button
          >
        </div>
        <div class="diag-caption">
          <span
            ><span class="dot" style="background:var(--gpon)"></span> Portadora GPON · 2,5 Gbps ↓</span
          >
          <span
            ><span class="dot" style="background:var(--xgs)"></span> Portadora XGS-PON · 10 Gbps ↓</span
          >
          <span
            ><span class="dot" style="background:var(--dim)"></span> Elemento pasivo (no cambia)</span
          >
          <span class="mono" style="margin-left:auto">▶ pulsos = tráfico descendente</span>
        </div>
      </div>
      <div class="info-box" id={DOM.infoBox}>
        <b>Explora el esquema.</b> Haz clic sobre la ONT, los splitters, el nodo OLT, la troncal o el
        PAO para ver qué son y cómo les afecta la renovación.
      </div>
    </div>
  </div>
</section>
