---
import { tourStops } from '../lib/data';
import { details } from '../lib/details';
import { DOM } from '../lib/dom-ids';
import { ui } from '../i18n/ui';

// The map is drawn by the src/scripts/map.ts island, which the tour
// (src/scripts/tour.ts) builds on. The 9 "see inside the cables" panels do
// arrive rendered from the build: the island only reveals the current one,
// already resolved to this page's locale.
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).map;
const shared = ui(locale).shared;
const stops = tourStops();
const panels = details(locale);
---

<section id="mapa" style="padding-top:20px">
  <div class="wrap">
    <div class="eyebrow">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="lead">
      {t.lead}
    </p>
    <div class="tour-bar">
      <button class="tour-btn" id={DOM.tourStart}>▶ {t.tourStart}</button>
      <button class="tour-btn ghost" id={DOM.townsToggle}>◉ {t.townsVisible}</button>
      <div class="tr-leg">
        <span><span class="tr-line"></span> {t.legendOwn}</span>
        <span><span class="tr-line rent"></span> {t.legendRented}</span>
      </div>
    </div>
    <div class="map-wrap" id={DOM.mapWrap} style="margin-top:30px">
      <div class="map-shell">
        <svg id={DOM.astMap} viewBox="0 0 1160 470" role="img" aria-label={t.mapAria}></svg>
        <div class="tooltip" id={DOM.mapTip}></div>
        {
          /* Kept off the svg entirely, unlike the zoom buttons below: the
            map's own width:height ratio (~2.5:1) puts the usual absolute
            top-right overlay right on top of «MAR CANTÁBRICO» and the
            Colombres/Porrúa labels on a phone (confirmed against the built
            output) — the same bug the wavelength ruler had
            (architecture.css), fixed the same way. Sits here, between the
            map and the area legend below, so it reads as the map's own
            control rather than the legend's. */
        }
        <div class="zoom-pad fs-row" role="group" aria-label={t.fsGroupLabel}>
          <button
            type="button"
            class="fs-trigger"
            data-fs-target={DOM.mapWrap}
            aria-label={t.fsBtnLabel}
            title={shared.fullscreenTitle}>⛶</button
          >
        </div>
        <div class="area-legend" id={DOM.areaLegend}></div>
      </div>
      <div class="zoom-pad" role="group" aria-label={t.zoomGroupLabel}>
        <button id={DOM.mapZoomIn} type="button" aria-label={t.zoomInLabel} title={t.zoomInTitle}
          >+</button
        >
        <button id={DOM.mapZoomOut} type="button" aria-label={t.zoomOutLabel} title={t.zoomOutTitle}
          >−</button
        >
      </div>
    </div>
    <div class="tour-panel" id={DOM.tourPanel}>
      <div class="tour-step" id={DOM.tpStep}></div>
      <h4 id={DOM.tpTitle}></h4>
      <p id={DOM.tpText}></p>
      <button class="tour-btn ghost" id={DOM.tpDetBtn} style="margin-top:12px"
        >■■ {t.cableOpen}</button
      >
      <div
        id={DOM.tpDet}
        style="display:none;position:relative;margin-top:12px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:14px 16px;font-family:'IBM Plex Mono',monospace;font-size:.72rem;line-height:1.7;color:var(--muted);overflow-x:auto"
      >
        {
          stops
            .filter((s) => panels[s.id])
            .map((s) => <div data-det={s.id} hidden set:html={panels[s.id]} />)
        }
        {
          /* One shared pad: only one [data-det] panel is ever visible, so
            tour.ts points these two buttons at whichever svg that is,
            instead of every panel carrying (and paying the layout cost of)
            its own. Panning works without the buttons too, straight off
            the svg via drag/touch — see initPannableZoom. */
        }
        <div class="zoom-pad" role="group" aria-label={t.cableZoomGroupLabel}>
          <button
            id={DOM.cableZoomIn}
            type="button"
            aria-label={t.cableZoomInLabel}
            title={t.zoomInTitle}>+</button
          >
          <button
            id={DOM.cableZoomOut}
            type="button"
            aria-label={t.cableZoomOutLabel}
            title={t.zoomOutTitle}>−</button
          >
          <button
            type="button"
            class="fs-trigger"
            data-fs-target={DOM.tpDet}
            aria-label={t.cableFsLabel}
            title={shared.fullscreenTitle}>⛶</button
          >
        </div>
      </div>
      <div class="tour-nav">
        <button class="tour-btn ghost" id={DOM.tpPrev}>◀ {t.tourPrev}</button>
        <button class="tour-btn" id={DOM.tpNext}>{t.tourNext} ▶</button>
        <button class="tour-btn" id={DOM.tpEnter} style="display:none">⌂ {t.tourEnter}</button>
        <button class="tour-btn ghost" id={DOM.tpExit} style="margin-left:auto"
          >✕ {t.tourExit}</button
        >
      </div>
    </div>
  </div>
</section>
