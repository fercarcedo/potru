---
import { heroStats } from '../lib/data';
import { DOM } from '../lib/dom-ids';
import { ui } from '../i18n/ui';

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).hero;
const stats = heroStats(locale);
---

<header class="hero">
  <svg id={DOM.heroFiber} preserveAspectRatio="none" viewBox="0 0 1400 600" aria-hidden="true"
  ></svg>
  <div class="wrap" style="position:relative">
    <h1>
      {t.titleLead}
      <em>{t.titleWave}</em><br /><span class="from">100 Mbps</span> →
      <span class="to">10 Gbps</span><br /><span class="tech"
        ><span class="from">GPON</span> → <span class="to">XGS-PON</span></span
      >
    </h1>
    <p class="sub">
      {t.sub}
    </p>
    <p class="disclaimer">
      <b>{t.disclaimerBold}</b>{t.disclaimerRest}
    </p>
    <div class="stats">
      {
        stats.map((s) => (
          <div class={s.highlight ? 'stat hl' : 'stat'}>
            <div class="n">{s.value}</div>
            <div class="l">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</header>

<style>
  /* Headline, animated fibre backdrop and the four headline figures — all
     this component's own markup, so scoping reaches everything below.
     .disclaimer is deliberately absent: it's a global class (base.css)
     shared with the footer's own independent copy in Layout.astro. */
  .hero {
    position: relative;
    padding: 110px 0 90px;
    overflow: hidden;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 800;
    line-height: 1.04;
    max-width: 20ch;
  }
  .hero h1 .from {
    color: var(--gpon-tx);
  }
  .hero h1 .to {
    color: var(--xgs-tx);
  }
  /* second hero line: the technology, under the headline capacity */
  .hero h1 .tech {
    display: inline-block;
    margin-top: 0.12em;
    font-size: 0.5em;
    letter-spacing: 0;
  }
  .hero p.sub {
    margin-top: 22px;
    color: var(--muted);
    max-width: 62ch;
    font-size: 1.06rem;
  }
  #heroFiber {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 56px;
  }
  .stat {
    background: var(--panel);
    padding: 20px 18px;
  }
  .stat .n {
    font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
    font-stretch: 85%;
    font-size: 1.7rem;
    font-weight: 700;
  }
  .stat .l {
    font-size: 0.76rem;
    color: var(--muted);
    margin-top: 2px;
    line-height: 1.35;
  }
  .stat.hl .n {
    color: var(--xgs-tx);
  }
  @media (max-width: 760px) {
    .hero {
      padding: 64px 0 56px;
    }
    .hero p.sub {
      font-size: 1rem;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat .n {
      font-size: 1.4rem;
    }
  }
</style>
