---
import { NODES } from '../lib/data';
import { DOM } from '../lib/dom-ids';
import { gantt, ganttList, ganttViewBox } from '../lib/graphics';
import { ui } from '../i18n/ui';

// The gantt is deterministic, so it is drawn at build time from nodes.json.
// The island only binds click and hover to each bar. Below 760px the plotted
// svg (bars) gives way to a stacked list (rows) with the same per-node
// data-node — see ganttList's own comment for why a gantt can't just shrink.
const bars = gantt(NODES);
const rows = ganttList(NODES);
const viewBox = ganttViewBox(NODES);
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).phases;
---

<section id="fases" style="padding-top:30px">
  <div class="wrap">
    <div class="eyebrow">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="lead">
      {t.lead}
    </p>

    <div class="timeline">
      <div class="phase">
        <h3>{t.phase1Heading}</h3>
        <div class="dur">{t.phase1Dur}</div>
        <p>
          {t.phase1Body}
        </p>
      </div>
      <div class="phase">
        <h3>{t.phase2Heading}</h3>
        <div class="dur">{t.phase2Dur}</div>
        <p>
          {t.phase2Body}
        </p>
        <div class="node-times">
          <div class="nt"><b>≤ 512 ONT</b>{t.nt1}</div>
          <div class="nt"><b>≤ 768 ONT</b>{t.nt2}</div>
          <div class="nt"><b>≤ 1024 ONT</b>{t.nt3}</div>
        </div>
        <h4 style="margin:26px 0 4px;font-size:.95rem">
          {t.calendarHeading}{' '}
          <span class="mono" style="font-size:.7rem;color:var(--muted)">{t.calendarNote}</span>
        </h4>
        <div class="gantt-shell">
          <svg
            id={DOM.gantt}
            viewBox={viewBox}
            role="img"
            aria-label={t.ganttAria}
            set:html={bars}
          />
          <div class="gantt-list" id={DOM.ganttList} set:html={rows} />
          <div class="gantt-note">
            {t.ganttNote}
          </div>
        </div>
      </div>
      <div class="phase">
        <h3>{t.phase3Heading}</h3>
        <div class="dur">{t.phase3Dur}</div>
        <p>
          {t.phase3Body}
        </p>
      </div>
    </div>
  </div>
</section>
