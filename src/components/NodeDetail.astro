---
import { asset, type NetworkNode } from '../lib/data';
import { renderActionLinks, renderAreaTag, renderMigStrip, renderOltTable, renderTownsBlock } from '../lib/node-render';

interface Props {
  node: NetworkNode;
}

const { node: n } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="node-detail">
  <a class="back-link" href={`${base}#nodos`}>◀ Volver a los 20 nodos</a>

  <h1>
    {n.name}
    <Fragment set:html={renderAreaTag(n)} />
  </h1>
  <div class="addr">📍 {n.address}</div>
  <p class="env">{n.enclosure}</p>
  {n.extra && <p class="extra">{n.extra}</p>}

  <div class="mig-strip" set:html={renderMigStrip(n)} />

  {
    n.olts.length > 0 && (
      <section class="block">
        <div class="act-label">Equipamiento OLT en producción</div>
        <div class="olt-wrap">
          <table class="olt-table" set:html={renderOltTable(n)} />
        </div>
      </section>
    )
  }

  {
    n.towns.length > 0 && (
      <section class="block" set:html={renderTownsBlock(n)} />
    )
  }

  {
    n.gallery.length > 1 && (
      <button class="tour-btn" id="detailWalk" data-walk={n.id} style="margin-top:6px">
        🚶 Recorrer el interior en 3D{' '}
        <span style="color:var(--muted);font-size:.66rem">
          · simulación generada a partir de planta y alzados
        </span>
      </button>
    )
  }

  <section class="block">
    <div class="act-label">Actuaciones del contrato que afectan a este nodo</div>
    <div class="act-links" set:html={renderActionLinks(n, base)} />
  </section>

  <section class="block">
    <div class="act-label">Planos del pliego · ubicación, planta y alzados</div>
    <div class="detail-gallery">
      {
        n.gallery.map((g) => (
          <figure>
            <img
              src={asset(g.src)}
              alt={`${g.label} · ${n.name}`}
              width={g.w}
              height={g.h}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{g.label.toUpperCase()}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</div>
