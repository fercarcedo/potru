---
import { ACTION_DESC, asset, cardLabel, ontCount, type NetworkNode } from '../lib/data';

interface Props {
  node: NetworkNode;
}

const { node: n } = Astro.props;
const base = import.meta.env.BASE_URL;
const isPao = n.id === 'pao';
const total = ontCount(n);
---

<div class="node-detail">
  <a class="back-link" href={`${base}#nodos`}>◀ Volver a los 20 nodos</a>

  <h1>
    {n.name}
    <span
      class="mtag"
      style={`background:${n.color}22;color:${n.color};border:1px solid ${n.color}55`}
      >ÁREA {n.area.toUpperCase()}</span
    >
  </h1>
  <div class="addr">📍 {n.address}</div>
  <p class="env">{n.enclosure}</p>
  {n.extra && <p class="extra">{n.extra}</p>}

  <div class="mig-strip">
    {
      isPao ? (
        <>
          <div class="box">
            <b>Fase 1</b>
            <span>semanas 1–12</span>
          </div>
          <div class="box">
            <b>Sin migración</b>
            <span>de usuarios</span>
          </div>
        </>
      ) : (
        <>
          <div class="box">
            <b>Semana {n.weekFrom}</b>
            <span>replanteo e inicio</span>
          </div>
          <div class="box">
            <b>Semana {n.weekTo}</b>
            <span>fin de migración</span>
          </div>
          <div class="box">
            <b>{n.weekTo - n.weekFrom + 1} semanas</b>
            <span>ventana total</span>
          </div>
          <div class="box">
            <b>{total} ONT</b>
            <span>a migrar</span>
          </div>
        </>
      )
    }
  </div>

  {
    n.olts.length > 0 && (
      <section class="block">
        <div class="act-label">Equipamiento OLT en producción</div>
        <div class="olt-wrap">
          <table class="olt-table">
            <tr>
              <th>OLT</th>
              <th>Equipo actual</th>
              <th>Tarjetas</th>
              <th>Puertos GPON act./tot.</th>
              <th>ONT</th>
            </tr>
            {n.olts.map((o) => (
              <tr>
                <td class="mono">{o.code}</td>
                <td>{o.vendor}</td>
                <td class="mono" title={o.note}>{cardLabel(o)}</td>
                <td class="mono">
                  {o.portsActive} / {o.portsTotal}
                </td>
                <td class="mono">{o.onts}</td>
              </tr>
            ))}
            {n.olts.length > 1 && (
              <tr class="total">
                <td colspan="4">Total del nodo</td>
                <td class="mono">{total}</td>
              </tr>
            )}
          </table>
        </div>
      </section>
    )
  }

  {
    n.towns.length > 0 && (
      <section class="block">
        <div class="act-label">Poblaciones servidas por este nodo</div>
        <div class="town-chips">
          {n.towns.map((p) => (
            <span>{p}</span>
          ))}
        </div>
        {n.townsNote && <div class="town-note">{n.townsNote}</div>}
        {n.ponGroups && (
          <>
            <div class="act-label" style="margin-top:14px">
              Árboles PON compartidos (detalle técnico)
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:10px">
              {n.ponGroups.groups.map((gr) => (
                <div class="pon-group">
                  {gr.map((p, i) => (
                    <>
                      {i > 0 && <span class="lnk">─◆─</span>}
                      <span class="p">{p}</span>
                    </>
                  ))}
                  <span class="tag">MISMA PON</span>
                </div>
              ))}
            </div>
            <div class="town-note" style="border-left-color:#c9a44e">
              {n.ponGroups.note}
            </div>
          </>
        )}
      </section>
    )
  }

  {
    n.gallery.length > 1 && (
      <button class="tour-btn" id="detailWalk" data-walk={n.id} style="margin-top:6px">
        🚶 Recorrer el interior en 3D{' '}
        <span style="color:var(--muted);font-size:.66rem">
          · simulación generada a partir de planta y alzados
        </span>
      </button>
    )
  }

  <section class="block">
    <div class="act-label">Actuaciones del contrato que afectan a este nodo</div>
    <div class="act-links">
      {
        n.actions.map((a) => {
          const [cls, desc, href] = ACTION_DESC[a]!;
          return (
            <a class={cls} href={`${base}${href}`} title={desc}>
              {a} · {desc}
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="block">
    <div class="act-label">Planos del pliego · ubicación, planta y alzados</div>
    <div class="detail-gallery">
      {
        n.gallery.map((g) => (
          <figure>
            <img
              src={asset(g.src)}
              alt={`${g.label} · ${n.name}`}
              width={g.w}
              height={g.h}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{g.label.toUpperCase()}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</div>
