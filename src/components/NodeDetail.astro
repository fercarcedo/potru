---
import { asset, type NetworkNode } from '../lib/data';
import {
  renderActionLinks,
  renderAreaTag,
  renderMigStrip,
  renderOltTable,
  renderTownsBlock,
} from '../lib/node-render';

interface Props {
  node: NetworkNode;
}

const { node: n } = Astro.props;
const base = import.meta.env.BASE_URL;
/* The record leads with the node's first plan, the way the modal leads with
   whichever tab is open; the rest go in the grid at the foot of the card, so
   no plan is shown twice. */
const [hero, ...plans] = n.gallery;
const towns = renderTownsBlock(n);
const olts = renderOltTable(n);
---

<a class="back-link" href={`${base}#nodos`}>◀ Volver a los 20 nodos</a>

<article class="node-detail">
  {
    hero && (
      <div class="node-hero">
        <a class="plan-link" data-plan href={asset(hero.src)} target="_blank" rel="noopener">
          <img
            src={asset(hero.src)}
            alt={`${hero.label} · ${n.name}`}
            width={hero.w}
            height={hero.h}
            decoding="async"
          />
        </a>
        <span class="hero-tag">{hero.label.toUpperCase()}</span>
      </div>
    )
  }

  <div class="node-body">
    <h1>
      {n.name}
      <Fragment set:html={renderAreaTag(n)} />
    </h1>
    <div class="addr">📍 {n.address}</div>
    <p class="env">{n.enclosure}</p>

    {towns && <div class="towns" set:html={towns} />}
    {n.extra && <p class="extra">{n.extra}</p>}

    {
      olts && (
        <>
          <div class="act-label">Equipamiento OLT en producción</div>
          <div class="olt-wrap">
            <table class="olt-table" set:html={olts} />
          </div>
        </>
      )
    }

    <div class="mig-strip" set:html={renderMigStrip(n)} />

    {
      n.gallery.length > 1 && (
        <button class="tour-btn" data-walk={n.id}>
          🚶 Recorrer el interior en 3D{' '}
          <span style="color:var(--muted);font-size:.66rem">
            · simulación generada a partir de planta y alzados
          </span>
        </button>
      )
    }

    <div class="act-label">Actuaciones del contrato que afectan a este nodo</div>
    <div class="act-links" set:html={renderActionLinks(n, base)} />

    {
      plans.length > 0 && (
        <>
          <div class="act-label plans-label">Resto de planos del pliego</div>
          <div class="detail-gallery">
            {plans.map((g) => (
              <figure>
                <a class="plan-link" data-plan href={asset(g.src)} target="_blank" rel="noopener">
                  <img
                    src={asset(g.src)}
                    alt={`${g.label} · ${n.name}`}
                    width={g.w}
                    height={g.h}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption>{g.label.toUpperCase()}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )
    }
  </div>
</article>
