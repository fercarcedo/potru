---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { asset, galleryLabel, type NetworkNode } from '../lib/data';
import { ui } from '../i18n/ui';
import {
  renderActionLinks,
  renderAreaTag,
  renderMigStrip,
  renderOltTable,
  renderTownsBlock,
} from '../lib/node-render';

interface Props {
  node: NetworkNode;
}

const { node: n } = Astro.props;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale);
/* The record leads with the node's first plan, the way the modal leads with
   whichever tab is open; the rest go in the grid at the foot of the card, so
   no plan is shown twice. */
const [hero, ...plans] = n.gallery;
const towns = renderTownsBlock(n, locale);
const olts = renderOltTable(n, locale);
/* Where "elsewhere" (renderActionLinks' own base param) resolves to: this
   locale's home page, not the plain BASE_URL — on /en/nodos/<id> the
   #act-* anchors it points at live at /en/, not /. */
const homeHref = getRelativeLocaleUrl(locale, '');
---

<a class="back-link" href={`${homeHref}#nodos`}>◀ {t.nodeDetail.backLink}</a>

<article class="node-detail">
  {
    hero && (
      <div class="node-hero">
        <a class="plan-link" data-plan href={asset(hero.src)} target="_blank" rel="noopener">
          <img
            src={asset(hero.src)}
            alt={`${galleryLabel(hero.label, locale)} · ${n.name}`}
            width={hero.w}
            height={hero.h}
            decoding="async"
          />
        </a>
        <span class="hero-tag">{galleryLabel(hero.label, locale).toUpperCase()}</span>
      </div>
    )
  }

  <div class="node-body">
    <h1>
      {n.name}
      <Fragment set:html={renderAreaTag(n, locale)} />
    </h1>
    <div class="addr">📍 {n.address}</div>
    <p class="env">{n.enclosure}</p>

    {towns && <div class="towns" set:html={towns} />}
    {n.extra && <p class="extra">{n.extra}</p>}

    {
      olts && (
        <>
          <div class="act-label">{t.nodeDetail.oltHeading}</div>
          <div class="olt-wrap">
            <table class="olt-table" set:html={olts} />
          </div>
        </>
      )
    }

    <div class="mig-strip" set:html={renderMigStrip(n, locale)} />

    {
      n.gallery.length > 1 && (
        <button class="tour-btn" data-walk={n.id}>
          🚶 {t.shared.walkLabel}{' '}
          <span style="color:var(--muted);font-size:.66rem">· {t.shared.walkNote}</span>
        </button>
      )
    }

    <div class="act-label">{t.shared.actionsAffecting}</div>
    <div class="act-links" set:html={renderActionLinks(n, homeHref, false, locale)} />

    {
      plans.length > 0 && (
        <>
          <div class="act-label plans-label">{t.nodeDetail.remainingPlans}</div>
          <div class="detail-gallery">
            {plans.map((g) => (
              <figure>
                <a class="plan-link" data-plan href={asset(g.src)} target="_blank" rel="noopener">
                  <img
                    src={asset(g.src)}
                    alt={`${galleryLabel(g.label, locale)} · ${n.name}`}
                    width={g.w}
                    height={g.h}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption>{galleryLabel(g.label, locale).toUpperCase()}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )
    }
  </div>
</article>
