---
import { ARCHITECTURE_STEPS, XGS_EXPLAINER } from '../lib/data';
import { mkSpectrum } from '../lib/graphics';
import { DOM } from '../lib/dom-ids';
---

<section
  id="arquitectura"
  style="background:linear-gradient(180deg,transparent,rgba(255,180,84,.03),transparent)"
>
  <div class="wrap">
    <div class="eyebrow warm">Situación de partida</div>
    <h2>Arquitectura actual de la Red Asturcón</h2>
    <p class="lead">
      Red FTTH pública, neutra y mayorista, operada por GIT desde 2004 para llevar banda ancha donde
      la iniciativa privada no despliega. Los operadores minoristas prestan sus servicios (HSI,
      TVoIP, VoD, VoIP, CATV en RF y telefonía POTS) sobre una misma ONT, con conectividad
      transparente hasta el PAO.
    </p>
    <div class="arch-flow">
      {
        ARCHITECTURE_STEPS.map((s) => (
          <div class="arch-step">
            <span class="k">{s.kicker}</span>
            <h4>{s.heading}</h4>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
    <div class="ont-bars">
      <h3 style="font-size:1.05rem;margin-bottom:6px">Parque de ONT en producción</h3>
      <p style="font-size:.85rem;color:var(--muted)">
        La heterogeneidad y antigüedad del parque motiva el suministro de hasta 7.000 ONT GPON
        nuevas en la parte variable del contrato.
      </p>
      <div id={DOM.ontBars} style="margin-top:16px"></div>
    </div>

    <div class="xgs-explain">
      <div class="eyebrow">La tecnología</div>
      <h3>Dos generaciones sobre el mismo hilo</h3>
      <div class="xgs-cols">
        <div class="xgs-col g">
          <h4>{XGS_EXPLAINER.gpon.label}</h4>
          <p class="rate">{XGS_EXPLAINER.gpon.rate}</p>
          <p>{XGS_EXPLAINER.gpon.text}</p>
        </div>
        <div class="xgs-col x">
          <h4>{XGS_EXPLAINER.xgs.label}</h4>
          <p class="rate">{XGS_EXPLAINER.xgs.rate}</p>
          <p>{XGS_EXPLAINER.xgs.text}</p>
        </div>
      </div>
      <p class="xgs-prose">{XGS_EXPLAINER.prose}</p>
      <svg
        class="xgs-ruler"
        viewBox="0 0 1000 160"
        role="img"
        aria-label="Ocupación del espectro sobre una misma fibra, con las bandas GPON y XGS-PON"
        set:html={mkSpectrum(XGS_EXPLAINER.bands, XGS_EXPLAINER.axisFrom, XGS_EXPLAINER.axisTo)}
      />
      <p class="xgs-source">
        <b>
          ⚠ {XGS_EXPLAINER.source.split('. ')[0]}.
        </b>{' '}
        {XGS_EXPLAINER.source.split('. ').slice(1).join('. ')}
      </p>
    </div>
  </div>
</section>
