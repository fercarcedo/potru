---
import { ARCHITECTURE_STEPS, XGS_EXPLAINER } from '../lib/data';
import { mkSpectrum } from '../lib/graphics';
import { DOM } from '../lib/dom-ids';
import { ui } from '../i18n/ui';

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).architecture;
const shared = ui(locale).shared;
---

<section
  id="arquitectura"
  style="background:linear-gradient(180deg,transparent,rgba(255,180,84,.03),transparent)"
>
  <div class="wrap">
    <div class="eyebrow warm">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="lead">
      {t.lead}
    </p>
    <div class="arch-flow">
      {
        ARCHITECTURE_STEPS.map((s) => (
          <div class="arch-step">
            <span class="k">{s.kicker}</span>
            <h4>{s.heading}</h4>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
    <div class="ont-bars">
      <h3 style="font-size:1.05rem;margin-bottom:6px">{t.ontHeading}</h3>
      <p style="font-size:.85rem;color:var(--muted)">
        {t.ontSub}
      </p>
      <div id={DOM.ontBars} style="margin-top:16px"></div>
    </div>

    <div class="xgs-explain">
      <div class="eyebrow">{t.techEyebrow}</div>
      <h3>{t.techHeading}</h3>
      <div class="xgs-cols">
        <div class="xgs-col g">
          <h4>{XGS_EXPLAINER.gpon.label}</h4>
          <p class="rate">{XGS_EXPLAINER.gpon.rate}</p>
          <p>{XGS_EXPLAINER.gpon.text}</p>
        </div>
        <div class="xgs-col x">
          <h4>{XGS_EXPLAINER.xgs.label}</h4>
          <p class="rate">{XGS_EXPLAINER.xgs.rate}</p>
          <p>{XGS_EXPLAINER.xgs.text}</p>
        </div>
      </div>
      <p class="xgs-prose">{XGS_EXPLAINER.prose}</p>
      <div class="ruler-wrap" id={DOM.rulerWrap}>
        <svg
          class="xgs-ruler"
          viewBox="0 0 1000 160"
          role="img"
          aria-label={t.spectrumAria}
          set:html={mkSpectrum(XGS_EXPLAINER.bands, XGS_EXPLAINER.axisFrom, XGS_EXPLAINER.axisTo)}
        />
        <div class="zoom-pad fs-row" role="group" aria-label={t.fsGroupLabel}>
          <button
            type="button"
            class="fs-trigger"
            data-fs-target={DOM.rulerWrap}
            aria-label={t.fsBtnLabel}
            title={shared.fullscreenTitle}>⛶</button
          >
        </div>
      </div>
      <p class="xgs-source">
        <b>
          ⚠ {XGS_EXPLAINER.source.split('. ')[0]}.
        </b>{' '}
        {XGS_EXPLAINER.source.split('. ').slice(1).join('. ')}
      </p>
    </div>
  </div>
</section>
