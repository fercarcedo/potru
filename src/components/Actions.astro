---
import ActionCard from './ActionCard.astro';
import { CONTRACT_ACTIONS } from '../lib/data';

const fija = CONTRACT_ACTIONS.filter((a) => a.part === 'fija');
const variable = CONTRACT_ACTIONS.filter((a) => a.part === 'variable');
---

<section id="actuaciones">
  <div class="wrap">
    <div class="eyebrow">Objeto del contrato</div>
    <h2>Actuaciones previstas</h2>
    <p class="lead">
      Parte fija llave en mano de alcance cerrado + parte variable activada según necesidades. Cada
      actuación indica los nodos a los que afecta: pulsa un nombre para abrir su ficha.
    </p>

    <h3 style="margin:34px 0 14px;font-size:1.1rem">Parte fija</h3>
    <div class="grid g3">
      {fija.map((a) => <ActionCard action={a} />)}
    </div>

    <h3 style="margin:34px 0 14px;font-size:1.1rem">Parte variable</h3>
    <div class="grid g3">
      {variable.map((a) => <ActionCard action={a} />)}
    </div>
  </div>
</section>
