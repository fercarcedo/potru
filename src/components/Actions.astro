---
import ActionCard from './ActionCard.astro';
import { contractActions } from '../lib/data';
import { ui } from '../i18n/ui';

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).actions;
const actions = contractActions(locale);
const fija = actions.filter((a) => a.part === 'fija');
const variable = actions.filter((a) => a.part === 'variable');
---

<section id="actuaciones">
  <div class="wrap">
    <div class="eyebrow">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="lead">
      {t.lead}
    </p>

    <h3 style="margin:34px 0 14px;font-size:1.1rem">{t.fixed}</h3>
    <div class="grid g3">
      {fija.map((a) => <ActionCard action={a} />)}
    </div>

    <h3 style="margin:34px 0 14px;font-size:1.1rem">{t.variable}</h3>
    <div class="grid g3">
      {variable.map((a) => <ActionCard action={a} />)}
    </div>
  </div>
</section>

<style>
  /* Only lays out this component's own two grid divs; ActionCard's cards
     flow into it as ordinary grid items, so scoping the grid itself doesn't
     need to reach into the child component. */
  .grid {
    display: grid;
    gap: 16px;
  }
  .g3 {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
