---
import { DOM } from '../lib/dom-ids';
import { ui } from '../i18n/ui';

// Wrapper for the 3D viewer. The scene is built by src/scripts/viewer3d.ts,
// loaded on demand (dynamic import) when "Recorrer el interior en 3D" is
// pressed. The simulation notice lives here, in the header, NOT inside the room.
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).viewer3d;
const shared = ui(locale).shared;
---

<div class="sv-bg" id={DOM.svBg}>
  <div class="sv-top">
    <h4 id={DOM.svTitle}></h4>
    {
      /* Collapsed by default on mobile (scripts/collapsible.ts, wired in
        walk.ts), expanded on desktop — same disclaimer either way, just not
        permanently claiming a third of a phone screen with no way to close
        it. The golden rule (CLAUDE.md) is what makes this non-optional
        content in the first place; collapsing it is only about it not
        being *forced* content. */
    }
    <button
      class="sv-warn-toggle"
      id={DOM.svWarnToggle}
      type="button"
      aria-expanded="false"
      aria-controls={DOM.svWarn}
      title={t.warnToggleTitle}
    >
      ⚠ {t.warnToggleLabel}
    </button>
    <button class="tour-btn" id={DOM.svMode} style="white-space:nowrap">⇄ {t.modeRenewed}</button>
    <button class="sv-exit" id={DOM.svExit}>✕ {shared.exit}</button>
  </div>
  <div class="sv-warn" id={DOM.svWarn}>
    ⚠ {t.warnText}
    <button class="sv-warn-close" id={DOM.svWarnClose} aria-label={t.warnClose}>✕</button>
  </div>
  <div style="position:relative;flex:1;display:flex">
    <canvas id={DOM.svCanvas}></canvas>
    <div class="sv-wm">{t.watermark}</div>
    <div class="sv-help">
      {t.help}
    </div>
    <div class="zoom-pad sv-zoom" role="group" aria-label={t.zoomGroupLabel}>
      <button id={DOM.svZoomIn} type="button" aria-label={t.zoomInTitle} title={t.zoomInTitle}
        >+</button
      >
      <button id={DOM.svZoomOut} type="button" aria-label={t.zoomOutTitle} title={t.zoomOutTitle}
        >−</button
      >
    </div>
    <div class="sv-legend-wrap">
      {
        /* Same collapse-on-mobile treatment as sv-warn above. #svLegend
          itself stays the innerHTML target viewer3d.ts already writes to —
          only its wrapper and this toggle are new, so that wiring didn't
          need to change. */
      }
      <button
        class="sv-legend-toggle"
        id={DOM.svLegendToggle}
        type="button"
        aria-expanded="false"
        aria-controls={DOM.svLegend}
        title={t.legendToggleTitle}>ⓘ</button
      >
      <div class="sv-legend" id={DOM.svLegend}></div>
    </div>
    <div class="sv-pad" id={DOM.svPad}>
      <button class="up" data-k="f">▲</button>
      <button data-k="l">◀</button><button data-k="b">▼</button><button data-k="r">▶</button>
    </div>
    <div class="sv-loading" id={DOM.svLoading} style="display:none">{t.loading}</div>
  </div>
</div>
