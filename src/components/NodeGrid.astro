---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ALL_NODES, CONTRACT_WEEKS, asset, ontCount } from '../lib/data';
import { ui } from '../i18n/ui';

/** The 46 weeks of phase 2 are measured against the contract's 58. */
const TOTAL_WEEKS = CONTRACT_WEEKS;
const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = ui(locale).nodeGrid;
---

<section id="nodos" style="padding-top:20px">
  <div class="wrap">
    <div class="eyebrow">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="lead">
      {t.lead}
    </p>
    <div class="node-grid">
      {
        ALL_NODES.map((n) => {
          /* the card is 230px wide: it gets the thumbnail, not the full plan */
          const cover = n.gallery[0]!.thumb ?? n.gallery[0]!;
          const left = (((n.weekFrom - 1) / TOTAL_WEEKS) * 100).toFixed(1);
          const width = (((n.weekTo - n.weekFrom + 1) / TOTAL_WEEKS) * 100).toFixed(1);
          const isPao = n.id === 'pao';
          return (
            <a class="ncard" href={getRelativeLocaleUrl(locale, `nodos/${n.id}`)} data-node={n.id}>
              <img
                src={asset(cover.src)}
                alt={t.altPlano(n.name)}
                width={cover.w}
                height={cover.h}
                loading="lazy"
                decoding="async"
              />
              <div class="body">
                <h4>
                  <span class="adot" style={`background:${n.color}`} />
                  {n.name}
                </h4>
                {n.towns.length > 0 && (
                  <div class="towns">
                    {n.towns.slice(0, 3).join(' · ')}
                    {n.towns.length > 3 ? ` · +${n.towns.length - 3}` : ''}
                  </div>
                )}
                <div class="meta">
                  <span>{isPao ? t.paoPhase1 : `${n.olts.length} OLT · ${ontCount(n)} ONT`}</span>
                  <span>
                    {n.gallery.length > 1 && <span class="int-flag">⌂ {t.interiorFlag}</span>}{' '}
                    {`${t.weekAbbrev} ${n.weekFrom}–${n.weekTo}`}
                  </span>
                </div>
                <div class="weeks">
                  <i style={`left:${left}%;width:${width}%;background:${n.color}`} />
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Every element below is written directly in this component's own map
     over ALL_NODES — no child component, no set:html — so scoping reaches
     all of it, including the a.ncard override. */
  .node-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 14px;
    margin-top: 34px;
  }
  .ncard {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition:
      transform 0.2s,
      border-color 0.2s;
    text-align: left;
    color: var(--txt);
    font-family: inherit;
  }
  .node-grid a.ncard {
    display: block;
    text-decoration: none;
  }
  .ncard:hover,
  .ncard:focus-visible {
    transform: translateY(-3px);
    border-color: #2c4266;
  }
  .ncard:focus-visible {
    outline: 2px solid var(--xgs);
    outline-offset: 2px;
  }
  .ncard img {
    width: 100%;
    height: 118px;
    object-fit: cover;
    object-position: right center;
    display: block;
    filter: saturate(0.85);
    border-bottom: 1px solid var(--line);
  }
  .ncard .body {
    padding: 13px 15px 15px;
  }
  .ncard h4 {
    font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
    font-stretch: 85%;
    font-size: 0.98rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ncard .adot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ncard .towns {
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 3px;
    line-height: 1.4;
  }
  /* Two facts, each of which has to survive as a unit. The card floor is
     230px and «1 OLT · 272 ONT» plus «⌂ INTERIOR sem 21–24» does not fit on
     one line there, so without the nowrap the break lands mid-phrase and
     leaves «ONT» alone on the second line. Wrapping the spans instead drops
     the second one whole. */
  .ncard .meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 10px;
  }
  .ncard .meta > span {
    white-space: nowrap;
  }
  .ncard .weeks {
    margin-top: 9px;
    height: 5px;
    background: var(--panel2);
    border-radius: 3px;
    position: relative;
    overflow: hidden;
  }
  .ncard .weeks i {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 3px;
    background: var(--xgs);
    opacity: 0.8;
  }
  .ncard .int-flag {
    font-size: 0.62rem;
    color: var(--xgs-tx);
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
  }
  @media (max-width: 760px) {
    .node-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
    .ncard img {
      height: 96px;
    }
  }
</style>
