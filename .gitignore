asturcon-xgspon*.html

# logs and environment
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.production

# system
.DS_Store

# local scratch: the running list of viewer problems, and the session ids for
# `claude --resume`. Both are working notes, not repo content.
changes.txt
sessions.txt

# throwaway scripts — screenshot drivers, perf harnesses. Named so they cannot
# be swept into a commit by a broad `git add`, which is how sessions.txt got in.
*.tmp.mjs
*.tmp.js
